{
  "version": "2.0",
  "functionRoot": "./.build/cloudfunctions",
  "functions": [
    {
      "name": "planning-api",
      "dir": "./.build/cloudfunctions/planning-api",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 25,
      "installDependency": false
    },
    {
      "name": "assistant-api",
      "dir": "./.build/cloudfunctions/assistant-api",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 120,
      "installDependency": false
    },
    {
      "name": "photo-cleanup",
      "dir": "./.build/cloudfunctions/photo-cleanup",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 25,
      "installDependency": false,
      "triggers": [
        {
          "name": "photo-cleanup-every-15-minutes",
          "type": "timer",
          "config": "0 */15 * * * * *"
        }
      ]
    }
  ]
}
