{
  "name": "fitness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "build": "pnpm build:web",
    "lint": "eslint .",
    "build:web": "pnpm --filter @fitness/web build",
    "build:web:test": "pnpm --filter @fitness/web build:test",
    "dev:web": "pnpm --filter @fitness/web dev",
    "typecheck:web": "pnpm --filter @fitness/web typecheck",
    "test:web": "pnpm --filter @fitness/web test",
    "test:web:e2e": "pnpm --filter @fitness/web test:e2e",
    "scan:web-secrets": "pnpm --filter @fitness/web scan:secrets",
    "scan:web-boundaries": "pnpm --filter @fitness/web scan:boundaries",
    "test": "vitest run",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tsconfig.json --noEmit",
    "web:test:preflight": "node apps/web/scripts/web-test-preflight.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.17.0",
    "eslint": "^9.32.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
