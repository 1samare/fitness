# Copy only the variable names you need into a private, ignored environment file.
# Keep all real IDs, contacts, prefixes, model selections, keys and evidence paths out of Git.

# Format: absolute path to a private reviewed-planning-dataset-v1 JSON outside this repository.
FITNESS_REVIEWED_DATASET_FILE=
# Format: ISO 8601 UTC instant used only for a controlled reproducible release validation.
FITNESS_RELEASE_NOW=
# Format: server-side reviewed dataset document identifier; no default or fixture value.
FITNESS_REVIEWED_DATASET_ID=
# Format: target CloudBase environment identifier selected privately for the release.
FITNESS_CLOUDBASE_ENV_ID=
# Format: comma-separated uppercase server configuration names, never their values.
FITNESS_CLOUDBASE_CONFIGURED_NAMES=

# Format: public controlled-beta operator display name; development placeholders are rejected.
FITNESS_PUBLIC_OPERATOR_NAME=
# Format: public privacy email or HTTPS contact; do not commit a real address here.
FITNESS_PUBLIC_PRIVACY_CONTACT=
# Format: public privacy notice version identifier.
FITNESS_PRIVACY_NOTICE_VERSION=

# Format: private CloudBase storage file-ID prefix configured only on the server.
CLOUDBASE_STORAGE_FILE_ID_PREFIX=
# Format: private server-side vision function name.
FITNESS_VISION_FUNCTION_NAME=
# Format: private server-side CloudBase environment used by the model SDK.
CLOUDBASE_ENV_ID=
# Format: explicitly selected server-side language-model Provider identifier.
FITNESS_LLM_PROVIDER_ID=
# Format: explicitly selected server-side model identifier.
FITNESS_LLM_MODEL=

# Format: optional absolute path to private cloud capacity input for 7C validation.
FITNESS_CLOUD_CAPACITY_INPUT_FILE=
