page {
  --color-primary: #176b51;
  --color-text: #17352b;
  --color-text-muted: #526b62;
  --color-border: #cdded6;
  --color-surface: #ffffff;
  --color-surface-soft: #f2f7f4;
  --color-error: #8a3d17;
}

.page { box-sizing: border-box; width: 100%; padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom)); }
.hero { display: flex; flex-direction: column; gap: 12rpx; padding: 28rpx 8rpx 32rpx; }
.eyebrow { color: var(--color-primary); font-size: 22rpx; font-weight: 600; letter-spacing: 4rpx; }
.title { color: var(--color-text); font-size: 46rpx; font-weight: 700; line-height: 1.25; }
.subtitle, .section-help, .field__hint, .disclaimer { color: var(--color-text-muted); font-size: 24rpx; line-height: 1.6; }
.card { box-sizing: border-box; width: 100%; margin-bottom: 24rpx; padding: 32rpx; border: 1rpx solid var(--color-border); border-radius: 28rpx; background: var(--color-surface); box-shadow: 0 12rpx 36rpx rgba(28, 62, 50, 0.08); }
.card--fallback { border-style: dashed; }
.section-title { display: block; margin-bottom: 12rpx; color: var(--color-text); font-size: 32rpx; font-weight: 700; }
.section-help { display: block; margin-bottom: 24rpx; }
.preview { width: 100%; height: 360rpx; margin-bottom: 16rpx; border-radius: 18rpx; background: var(--color-surface-soft); }
.button { box-sizing: border-box; min-height: 88rpx; border-radius: 18rpx; font-size: 28rpx; font-weight: 700; }
.button::after { border: 0; }
.button--wide { width: 100%; margin-top: 16rpx; }
.button--primary { color: #ffffff; background: var(--color-primary); }
.button--secondary { color: var(--color-primary); border: 2rpx solid var(--color-primary); background: #ffffff; }
.button[disabled] { color: #71847d; border-color: #e7eeea; background: #e7eeea; opacity: 0.78; }
.candidate-list { display: flex; flex-direction: column; gap: 16rpx; }
.candidate { display: flex; box-sizing: border-box; min-height: 108rpx; align-items: center; gap: 16rpx; padding: 20rpx; border: 2rpx solid var(--color-border); border-radius: 18rpx; }
.candidate__content { display: flex; min-width: 0; flex-direction: column; gap: 6rpx; }
.candidate__name { color: var(--color-text); font-size: 28rpx; font-weight: 700; }
.candidate__meta, .candidate__notice { color: var(--color-text-muted); font-size: 23rpx; line-height: 1.5; }
.candidate__notice { color: var(--color-primary); font-weight: 600; }
.field { display: block; margin-top: 24rpx; }
.field__label { display: block; margin-bottom: 8rpx; color: var(--color-text); font-size: 26rpx; font-weight: 600; }
.field__control { box-sizing: border-box; width: 100%; min-height: 88rpx; padding: 20rpx 22rpx; border: 2rpx solid transparent; border-radius: 16rpx; color: var(--color-text); background: var(--color-surface-soft); font-size: 28rpx; }
.field__hint { display: block; margin-top: 8rpx; }
.notice { box-sizing: border-box; width: 100%; margin-bottom: 24rpx; padding: 24rpx; border-radius: 18rpx; font-size: 26rpx; line-height: 1.55; }
.notice--neutral { color: var(--color-text); border: 2rpx solid var(--color-border); background: var(--color-surface-soft); }
.notice--success { color: #0d5a42; border: 2rpx solid #88bba7; background: #f1fff8; }
.notice--error { color: var(--color-error); border: 2rpx solid #e5ae91; background: #fff1e9; }
.disclaimer { display: block; padding: 8rpx 8rpx 24rpx; }

@media (max-width: 360px) {
  .page { padding-right: 24rpx; padding-left: 24rpx; }
  .card { padding: 24rpx; }
}
