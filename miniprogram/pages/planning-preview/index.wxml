<view class="page">
  <view class="hero">
    <text class="eyebrow">FITNESS · 第一阶段</text>
    <text class="title">每日能量规划预览</text>
    <text class="subtitle">填写身体档案、目标和当日训练，获得可追溯的初始估算。</text>
  </view>

  <view class="card" aria-role="form" aria-label="每日能量规划输入">
    <text class="section-title">身体档案</text>
    <view class="field">
      <text class="field-label">年龄（岁）· 必填</text>
      <input type="number" value="{{ageYears}}" bindinput="onAgeInput" placeholder="18–45" aria-label="年龄" />
    </view>
    <view class="field-row">
      <view class="field field-half">
        <text class="field-label">身高（厘米）· 必填</text>
        <input type="digit" value="{{heightCm}}" bindinput="onHeightInput" placeholder="例如 175" aria-label="身高，单位厘米" />
      </view>
      <view class="field field-half">
        <text class="field-label">体重（千克）· 必填</text>
        <input type="digit" value="{{weightKg}}" bindinput="onWeightInput" placeholder="例如 70" aria-label="体重，单位千克" />
      </view>
    </view>
    <view class="field">
      <text class="field-label">公式性别变量 · 必选</text>
      <radio-group class="radio-group" bindchange="onSexChange" aria-label="公式性别变量">
        <label class="radio-option"><radio value="0" checked="{{sexCode === '0'}}" />男</label>
        <label class="radio-option"><radio value="1" checked="{{sexCode === '1'}}" />女</label>
      </radio-group>
      <text class="field-help">仅用于已确认公式，必须由本人提供。</text>
    </view>

    <text class="section-title section-spaced">目标与活动</text>
    <view class="field">
      <text class="field-label">非训练日常活动 · 必选</text>
      <picker range="{{activityLabels}}" value="{{activityIndex}}" bindchange="onActivityChange">
        <view class="picker-value">{{activityLabels[activityIndex]}}</view>
      </picker>
      <text class="field-help">只评价工作、通勤和家务，不包含下方明确训练。</text>
    </view>
    <view class="field">
      <text class="field-label">健身目标 · 必选</text>
      <picker range="{{goalLabels}}" value="{{goalIndex}}" bindchange="onGoalChange">
        <view class="picker-value">{{goalLabels[goalIndex]}}</view>
      </picker>
    </view>
    <view class="field">
      <text class="field-label">当日计划训练 · 必选</text>
      <picker range="{{trainingLabels}}" value="{{trainingIndex}}" bindchange="onTrainingChange">
        <view class="picker-value">{{trainingLabels[trainingIndex]}}</view>
      </picker>
    </view>
    <view wx:if="{{trainingIndex === 2}}" class="field">
      <text class="field-label">有效训练时长（分钟）</text>
      <input type="digit" value="{{durationMinutes}}" bindinput="onDurationInput" placeholder="例如 60" aria-label="有效训练时长，单位分钟" />
    </view>

    <label class="consent">
      <switch checked="{{healthScopeConfirmed}}" bindchange="onHealthScopeChange" aria-label="确认健康适用范围" />
      <text>我已确认不属于疾病治疗、孕哺期、进食障碍或伤病康复等需专业管理人群</text>
    </label>
    <button class="primary-button" type="primary" loading="{{loading}}" disabled="{{loading}}" bindtap="onSubmit">生成预览</button>
  </view>

  <view wx:if="{{supportedResult}}" class="card result-card" aria-role="region" aria-label="能量规划结果">
    <text class="section-kicker">已通过适用范围门禁</text>
    <text class="section-title">今日规划起点</text>
    <view class="metric"><text>BMI</text><text class="metric-value">{{supportedResult.bmi}}</text></view>
    <view class="metric"><text>估算 BMR</text><text class="metric-value">{{supportedResult.estimatedBmrKcal}} kcal</text></view>
    <view class="metric"><text>非训练基线</text><text class="metric-value">{{supportedResult.nonTrainingBaselineKcal}} kcal</text></view>
    <view class="metric"><text>训练净消耗</text><text class="metric-value">{{supportedResult.trainingNetKcal}} kcal</text></view>
    <view class="metric"><text>估算维持消耗</text><text class="metric-value">{{supportedResult.estimatedMaintenanceKcal}} kcal</text></view>
    <view class="metric primary"><text>目标能量起点</text><text class="metric-value">{{supportedResult.targetEnergyKcal}} kcal</text></view>
    <text class="metadata">策略：{{supportedResult.policy.policyVersion}}</text>
    <text class="metadata">来源：{{supportedSourceText}}</text>
    <text class="disclaimer">{{supportedResult.disclaimer}}</text>
  </view>

  <view wx:if="{{unsupportedResult}}" class="card warning-card" aria-role="region" aria-label="暂不支持自动个性化能量">
    <text class="section-title">暂不生成个性化能量目标</text>
    <text>BMI（仅用于范围判断）：{{unsupportedResult.bmi}}</text>
    <text class="warning-text">{{unsupportedReasonText}}</text>
    <text class="metadata">策略：{{unsupportedResult.policy.policyVersion}}</text>
  </view>

  <view wx:if="{{errorMessage}}" class="error" aria-role="alert">
    <text>{{errorMessage}}</text>
    <text class="error-help">请检查输入；如为连接错误，请先运行本地 API 后重试。</text>
  </view>
  <text class="phase-note">本阶段仅提供每日能量起点预览，尚未生成宏量营养目标或食谱。</text>
</view>
