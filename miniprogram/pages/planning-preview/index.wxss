.page {
  box-sizing: border-box;
  width: 100%;
  padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

.hero {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 32rpx 8rpx 40rpx;
}

.eyebrow {
  color: #047857;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.title {
  color: #0f2f25;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.2;
}

.subtitle,
.phase-note,
.metadata,
.disclaimer,
.field-help,
.error-help {
  color: #536b63;
  font-size: 26rpx;
  line-height: 1.6;
}

.card {
  margin-bottom: 24rpx;
  padding: 32rpx;
  border: 2rpx solid #d6ede5;
  border-radius: 28rpx 28rpx 20rpx 28rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(15, 47, 37, 0.06);
}

.section-title {
  display: block;
  margin-bottom: 20rpx;
  color: #17352b;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
}

.section-spaced {
  margin-top: 40rpx;
}

.section-kicker {
  display: block;
  margin-bottom: 8rpx;
  color: #047857;
  font-size: 24rpx;
  font-weight: 600;
}

.field {
  min-width: 0;
  margin-bottom: 28rpx;
}

.field-row {
  display: flex;
  gap: 20rpx;
}

.field-half {
  flex: 1;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: #24473b;
  font-size: 27rpx;
  font-weight: 600;
}

input,
.picker-value,
.radio-group {
  box-sizing: border-box;
  min-height: 88rpx;
  padding: 22rpx 24rpx;
  border: 2rpx solid #dcebe6;
  border-radius: 16rpx;
  background: #f5faf8;
  font-size: 28rpx;
}

.picker-value {
  position: relative;
  padding-right: 56rpx;
  line-height: 42rpx;
}

.picker-value::after {
  position: absolute;
  top: 30rpx;
  right: 24rpx;
  width: 12rpx;
  height: 12rpx;
  border-right: 3rpx solid #527168;
  border-bottom: 3rpx solid #527168;
  content: "";
  transform: rotate(45deg);
}

.radio-group {
  display: flex;
  align-items: center;
  gap: 40rpx;
}

.radio-option {
  display: flex;
  align-items: center;
  min-height: 48rpx;
}

radio {
  margin-right: 10rpx;
}

.field-help {
  display: block;
  margin-top: 10rpx;
}

.consent {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  margin: 8rpx 0 28rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: #effaf6;
  color: #35594d;
  font-size: 25rpx;
  line-height: 1.55;
}

.consent switch {
  flex: none;
}

.primary-button {
  min-height: 96rpx;
  border-radius: 18rpx;
  background: #057a55;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}

.primary-button[disabled] {
  opacity: 0.48;
}

.metric {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #edf3f0;
  font-size: 27rpx;
}

.metric-value {
  flex: none;
  font-variant-numeric: tabular-nums;
  font-weight: 600;
}

.metric.primary {
  color: #046c4e;
  font-size: 31rpx;
  font-weight: 700;
}

.metadata,
.disclaimer,
.warning-text,
.error-help {
  display: block;
  margin-top: 16rpx;
}

.warning-card {
  border-color: #edc995;
  background: #fffaf1;
}

.warning-text,
.error {
  color: #8a3d16;
}

.error {
  margin: 20rpx 0;
  padding: 24rpx;
  border: 2rpx solid #f2c5b6;
  border-radius: 16rpx;
  background: #fff1ec;
  font-size: 27rpx;
  line-height: 1.5;
}

.phase-note {
  display: block;
  padding: 12rpx 8rpx 24rpx;
}

@media (orientation: landscape) {
  .page {
    max-width: 1120rpx;
    margin: 0 auto;
  }
}
