page {
  --color-primary: #176b51;
  --color-primary-pressed: #0f513d;
  --color-text: #17352b;
  --color-text-muted: #526b62;
  --color-surface: #ffffff;
  --color-surface-soft: #f2f7f4;
  --color-border: #cdded6;
  --color-disabled: #e7eeea;
  --color-error: #8a3d17;
  --color-error-surface: #fff1e9;
}

.page { padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom)); }
.hero { display: flex; flex-direction: column; gap: 12rpx; padding: 28rpx 8rpx 32rpx; }
.eyebrow { color: var(--color-primary); font-size: 22rpx; font-weight: 600; letter-spacing: 4rpx; }
.title { color: var(--color-text); font-size: 46rpx; font-weight: 700; line-height: 1.25; }
.subtitle, .hint, .field__hint { color: var(--color-text-muted); font-size: 24rpx; line-height: 1.6; }

.card {
  margin-bottom: 24rpx;
  padding: 32rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 28rpx;
  background: var(--color-surface);
  box-shadow: 0 12rpx 36rpx rgba(28, 62, 50, 0.08);
}
.section-title { display: block; margin-bottom: 28rpx; color: var(--color-text); font-size: 32rpx; font-weight: 700; }
.field { display: block; margin-bottom: 24rpx; }
.field__label { display: block; margin-bottom: 10rpx; color: var(--color-text); font-size: 26rpx; font-weight: 600; line-height: 1.5; }
.field__control, .radio-group {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  padding: 20rpx 22rpx;
  border: 2rpx solid transparent;
  border-radius: 16rpx;
  color: var(--color-text);
  background: var(--color-surface-soft);
  font-size: 28rpx;
  line-height: 1.5;
}
.field__control:focus { border-color: var(--color-primary); }
.field__control--disabled { color: var(--color-text-muted); background: var(--color-disabled); opacity: 0.62; }
.field__hint { display: block; margin-top: 8rpx; }
.picker { display: flex; align-items: center; }
.radio-group { display: flex; align-items: center; gap: 32rpx; }
.radio-option { display: flex; align-items: center; min-height: 48rpx; margin: 0; }
.radio-option radio { margin-right: 8rpx; }

.consent {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  min-height: 88rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  color: var(--color-text);
  background: var(--color-surface-soft);
  font-size: 24rpx;
  line-height: 1.55;
}
.consent switch { flex: 0 0 auto; }

.empty-state {
  margin-bottom: 24rpx;
  padding: 24rpx;
  border: 2rpx dashed var(--color-border);
  border-radius: 16rpx;
  color: var(--color-text-muted);
  font-size: 24rpx;
  line-height: 1.55;
}
.training-day {
  margin-bottom: 20rpx;
  padding: 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 20rpx;
  background: var(--color-surface);
}
.training-day--disabled { background: var(--color-disabled); opacity: 0.72; }
.training-day__header { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; min-height: 88rpx; }
.training-day__date-group { display: flex; min-width: 0; flex-direction: column; gap: 4rpx; }
.training-day__date { color: var(--color-text); font-size: 28rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.training-day__reason { color: var(--color-error); font-size: 22rpx; font-weight: 600; }
.training-day__switch { display: flex; flex: 0 0 auto; align-items: center; gap: 12rpx; min-height: 88rpx; font-size: 24rpx; }
.training-day__fields { display: grid; grid-template-columns: minmax(0, 1fr) minmax(160rpx, 0.55fr); gap: 16rpx; margin-top: 16rpx; }
.field--compact { min-width: 0; margin-bottom: 0; }
.field--compact .field__control { min-height: 80rpx; padding: 16rpx; font-size: 26rpx; }

.hint { display: block; margin: 20rpx 0 24rpx; }
.submit-button { min-height: 96rpx; border-radius: 18rpx; background: var(--color-primary); font-size: 30rpx; font-weight: 700; }
.submit-button:active { background: var(--color-primary-pressed); }
.result-card { border-color: #88bba7; background: #f1fff8; }
.success { display: block; margin-bottom: 20rpx; color: #0d5a42; font-size: 28rpx; font-weight: 700; }
.target-row { display: flex; justify-content: space-between; gap: 16rpx; padding: 18rpx 0; border-bottom: 1rpx solid var(--color-border); font-size: 26rpx; }
.error { margin: 20rpx 0; padding: 24rpx; border-radius: 16rpx; color: var(--color-error); background: var(--color-error-surface); font-size: 26rpx; line-height: 1.55; }

@media (max-width: 360px) {
  .page { padding-left: 24rpx; padding-right: 24rpx; }
  .card { padding: 24rpx; }
  .training-day__fields { grid-template-columns: 1fr; }
}
