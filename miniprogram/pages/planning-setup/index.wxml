<view class="page">
  <view class="hero">
    <text class="eyebrow">FITNESS · 版本化规划</text>
    <text class="title">创建一周训练与能量目标</text>
    <text class="subtitle">按身体档案、目标、训练顺序保存；每次提交都会保留历史版本。</text>
  </view>

  <view class="card">
    <text class="section-title">1. 身体档案与偏好</text>
    <input type="number" value="{{ageYears}}" bindinput="onAgeInput" placeholder="年龄（自动能量支持 18–45 岁）" />
    <input type="digit" value="{{heightCm}}" bindinput="onHeightInput" placeholder="身高（厘米）" />
    <input type="digit" value="{{weightKg}}" bindinput="onWeightInput" placeholder="体重（千克）" />
    <radio-group bindchange="onSexChange">
      <label><radio value="0" checked="{{sexCode === '0'}}" />男</label>
      <label><radio value="1" checked="{{sexCode === '1'}}" />女</label>
    </radio-group>
    <picker range="{{activityLabels}}" value="{{activityIndex}}" bindchange="onActivityChange">
      <view class="picker">非训练日常活动：{{activityLabels[activityIndex]}}</view>
    </picker>
    <input value="{{allergens}}" bindinput="onAllergensInput" placeholder="过敏原，逗号分隔；没有可留空" />
    <input value="{{avoidFoods}}" bindinput="onAvoidFoodsInput" placeholder="忌口，逗号分隔" />
    <input value="{{dietPreferences}}" bindinput="onDietPreferencesInput" placeholder="饮食偏好，逗号分隔" />
    <label class="consent"><switch checked="{{healthScopeConfirmed}}" bindchange="onHealthScopeChange" />我已确认不属于疾病治疗、孕哺期、进食障碍或伤病康复等需专业管理人群</label>
  </view>

  <view class="card">
    <text class="section-title">2. 健身目标</text>
    <picker range="{{goalLabels}}" value="{{goalIndex}}" bindchange="onGoalChange">
      <view class="picker">目标：{{goalLabels[goalIndex]}}</view>
    </picker>
    <input type="digit" value="{{targetWeightKg}}" bindinput="onTargetWeightInput" placeholder="目标体重（可选，千克）" />
    <picker mode="date" value="{{effectiveDate}}" bindchange="onEffectiveDateChange">
      <view class="picker">目标生效日：{{effectiveDate || '请选择'}}</view>
    </picker>
    <picker mode="date" value="{{targetDate}}" bindchange="onTargetDateChange">
      <view class="picker">目标日期：{{targetDate || '请选择'}}</view>
    </picker>
  </view>

  <view class="card">
    <text class="section-title">3. 一周训练</text>
    <picker mode="date" value="{{weekStartDate}}" bindchange="onWeekStartDateChange">
      <view class="picker">规划周开始日：{{weekStartDate || '请选择'}}</view>
    </picker>
    <label class="consent"><switch checked="{{hasTraining}}" bindchange="onHasTrainingChange" />本周安排多动作抗阻训练</label>
    <block wx:if="{{hasTraining}}">
      <picker mode="date" value="{{trainingDate}}" bindchange="onTrainingDateChange">
        <view class="picker">训练日期：{{trainingDate || '请选择'}}</view>
      </picker>
      <input type="digit" value="{{durationMinutes}}" bindinput="onDurationInput" placeholder="有效训练分钟数" />
      <text class="hint">当前审核映射：2024 Adult Compendium 会话 02054；客户端不提交 MET。</text>
    </block>
    <button type="primary" loading="{{loading}}" disabled="{{loading}}" bindtap="onSubmit">保存并生成七天能量目标</button>
  </view>

  <view wx:if="{{successMessage}}" class="card result-card">
    <text class="success">{{successMessage}}</text>
    <view wx:for="{{displayTargets}}" wx:key="businessDate" class="target-row">
      <text>{{item.businessDate}}</text><text>{{item.energyText}}</text>
    </view>
    <text class="hint">当前仅生成确定性能量目标，宏量营养与食谱将在后续阶段加入。</text>
  </view>
  <view wx:if="{{errorMessage}}" class="error">{{errorMessage}}</view>
</view>
