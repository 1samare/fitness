.page { min-height: 100vh; padding: 32rpx; box-sizing: border-box; }
.hero, .card { display: flex; flex-direction: column; gap: 16rpx; }
.hero { margin-bottom: 28rpx; }
.eyebrow { color: #047857; font-size: 24rpx; font-weight: 700; letter-spacing: 2rpx; }
.title { color: #17352b; font-size: 48rpx; font-weight: 800; line-height: 1.2; }
.subtitle { color: #49685d; line-height: 1.6; }
.card { margin-bottom: 24rpx; padding: 28rpx; border: 1rpx solid #bbf7d0; border-radius: 24rpx; background: #fff; line-height: 1.65; }
.section-title { color: #14532d; font-size: 32rpx; font-weight: 750; }
.identity { background: #f0fdf4; }
.warning { border-color: #fcd34d; background: #fffbeb; }
.button { margin-top: 12rpx; border-radius: 16rpx; }
.button--primary { background: #047857; color: #fff; }
