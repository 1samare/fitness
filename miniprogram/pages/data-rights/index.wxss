.page { min-height: 100vh; padding: 32rpx; box-sizing: border-box; }
.hero { display: flex; flex-direction: column; gap: 14rpx; margin-bottom: 28rpx; }
.eyebrow { color: #047857; font-size: 24rpx; font-weight: 700; letter-spacing: 2rpx; }
.title { color: #17352b; font-size: 48rpx; font-weight: 800; }
.subtitle { color: #49685d; line-height: 1.6; }
.card { display: flex; flex-direction: column; gap: 16rpx; margin-bottom: 24rpx; padding: 28rpx; border: 1rpx solid #bbf7d0; border-radius: 24rpx; background: #fff; line-height: 1.6; }
.section-heading { display: flex; align-items: center; justify-content: space-between; }
.section-title { color: #14532d; font-size: 32rpx; font-weight: 750; }
.button { border-radius: 16rpx; }
.button--primary { background: #047857; color: #fff; }
.button--secondary { border: 1rpx solid #047857; background: #fff; color: #047857; }
.danger { border-color: #fecaca; background: #fff7f7; }
.danger__title, .danger__warning { color: #991b1b; }
.field { display: flex; flex-direction: column; gap: 10rpx; }
.field input { padding: 18rpx; border: 1rpx solid #fca5a5; border-radius: 12rpx; background: #fff; }
.button--danger { background: #b91c1c; color: #fff; }
.notice { margin-bottom: 20rpx; padding: 22rpx; border-radius: 14rpx; }
.notice--success { background: #dcfce7; color: #166534; }
.notice--error { background: #fee2e2; color: #991b1b; }
.privacy-link { background: transparent; color: #047857; }
