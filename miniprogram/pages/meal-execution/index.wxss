page {
  --color-primary: #176b51;
  --color-primary-pressed: #0f513d;
  --color-text: #17352b;
  --color-text-muted: #526b62;
  --color-surface: #ffffff;
  --color-surface-soft: #f2f7f4;
  --color-border: #cdded6;
  --color-disabled: #e7eeea;
  --color-error: #8a3d17;
  --color-error-surface: #fff1e9;
  --color-warning: #6f5413;
  --color-warning-surface: #fff8dc;
}

.page { box-sizing: border-box; width: 100%; padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom)); overflow-x: hidden; }
.hero { display: flex; flex-direction: column; gap: 12rpx; padding: 28rpx 8rpx 32rpx; }
.eyebrow { color: var(--color-primary); font-size: 22rpx; font-weight: 600; letter-spacing: 4rpx; }
.title { color: var(--color-text); font-size: 46rpx; font-weight: 700; line-height: 1.25; overflow-wrap: anywhere; }
.subtitle, .section-help, .field__hint, .disclaimer { color: var(--color-text-muted); font-size: 24rpx; line-height: 1.6; overflow-wrap: anywhere; }

.card {
  box-sizing: border-box;
  width: 100%;
  margin-bottom: 24rpx;
  padding: 32rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 28rpx;
  background: var(--color-surface);
  box-shadow: 0 12rpx 36rpx rgba(28, 62, 50, 0.08);
}
.card--decision { border-color: #d6bd68; background: #fffdf5; }
.section-title { display: block; margin-bottom: 12rpx; color: var(--color-text); font-size: 32rpx; font-weight: 700; line-height: 1.4; }
.section-help { display: block; margin-bottom: 24rpx; }

.field { display: block; min-width: 0; margin-bottom: 16rpx; }
.field--week { margin-top: 24rpx; }
.field__label { display: block; margin-bottom: 8rpx; color: var(--color-text); font-size: 26rpx; font-weight: 600; line-height: 1.5; }
.field__control {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  padding: 20rpx 22rpx;
  border: 2rpx solid transparent;
  border-radius: 16rpx;
  color: var(--color-text);
  background: var(--color-surface-soft);
  font-size: 28rpx;
  line-height: 1.5;
}
.field__control:focus { border-color: var(--color-primary); }
.field__hint { display: block; margin-top: 8rpx; }
.picker { display: flex; min-height: 88rpx; align-items: center; }
.picker--compact { box-sizing: border-box; justify-content: center; min-width: 216rpx; padding: 16rpx 20rpx; border: 2rpx solid var(--color-border); border-radius: 16rpx; color: var(--color-primary); font-size: 24rpx; font-weight: 600; }
.control--disabled { color: var(--color-text-muted); background: var(--color-disabled); opacity: 0.72; }

.inventory-row { margin-bottom: 24rpx; padding: 24rpx; border: 2rpx solid var(--color-border); border-radius: 20rpx; background: var(--color-surface-soft); }
.row-actions { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16rpx; }
.row-status { display: block; margin-top: 16rpx; font-size: 24rpx; font-weight: 600; line-height: 1.5; overflow-wrap: anywhere; }
.row-status--resolved { color: var(--color-primary); }
.row-status--error { color: var(--color-error); }
.row-status--resolving, .row-status--idle { color: var(--color-text-muted); }

.button { box-sizing: border-box; min-height: 88rpx; border-radius: 18rpx; font-size: 28rpx; font-weight: 700; line-height: 1.4; }
.button::after { border: 0; }
.button--wide { width: 100%; margin-top: 16rpx; }
.button--primary { color: #ffffff; background: var(--color-primary); }
.button--primary:active { background: var(--color-primary-pressed); }
.button--secondary { color: var(--color-primary); border: 2rpx solid var(--color-primary); background: #ffffff; }
.button--secondary:active { color: #ffffff; background: var(--color-primary-pressed); }
.button--ghost { color: var(--color-text-muted); border: 2rpx solid var(--color-border); background: transparent; }
.button[disabled] { color: #71847d; border-color: var(--color-disabled); background: var(--color-disabled); opacity: 0.78; }

.notice { display: flex; box-sizing: border-box; width: 100%; flex-direction: column; gap: 16rpx; margin-bottom: 24rpx; padding: 24rpx; border-radius: 18rpx; font-size: 26rpx; line-height: 1.55; overflow-wrap: anywhere; }
.notice__title { font-weight: 700; }
.notice--neutral { color: var(--color-text); border: 2rpx solid var(--color-border); background: var(--color-surface-soft); }
.notice--success { color: #0d5a42; border: 2rpx solid #88bba7; background: #f1fff8; }
.notice--warning { color: var(--color-warning); border: 2rpx solid #d6bd68; background: var(--color-warning-surface); }
.notice--error { color: var(--color-error); border: 2rpx solid #e5ae91; background: var(--color-error-surface); }

.empty-state { padding: 24rpx; border: 2rpx dashed var(--color-border); border-radius: 16rpx; color: var(--color-text-muted); font-size: 24rpx; line-height: 1.55; }
.meal-day { margin-bottom: 24rpx; padding: 24rpx; border: 2rpx solid var(--color-border); border-radius: 20rpx; background: var(--color-surface); }
.meal-day__header { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-height: 88rpx; }
.meal-day__heading { display: flex; min-width: 0; flex-direction: column; gap: 8rpx; }
.meal-day__date { color: var(--color-text); font-size: 29rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.status-pill { align-self: flex-start; padding: 6rpx 14rpx; border-radius: 999rpx; color: var(--color-primary); background: #e4f4ec; font-size: 22rpx; font-weight: 700; }
.switch-control { display: flex; min-height: 88rpx; flex: 0 0 auto; align-items: center; gap: 12rpx; color: var(--color-text); font-size: 24rpx; }
.meal-day__summary { display: block; margin-top: 12rpx; color: var(--color-text-muted); font-size: 23rpx; line-height: 1.55; overflow-wrap: anywhere; }
.meal-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid var(--color-border); }
.meal-row__label { display: flex; min-width: 0; flex-direction: column; gap: 6rpx; }
.meal-row__slot { color: var(--color-primary); font-size: 23rpx; font-weight: 700; }
.meal-row__dish { color: var(--color-text); font-size: 27rpx; font-weight: 600; line-height: 1.5; overflow-wrap: anywhere; }
.meal-row__ingredients { display: flex; min-width: 0; flex-direction: column; gap: 4rpx; }
.meal-row__ingredient { color: var(--color-text-muted); font-size: 24rpx; line-height: 1.5; overflow-wrap: anywhere; }

.diff-row { display: flex; flex-direction: column; gap: 6rpx; margin-bottom: 16rpx; padding: 20rpx; border-radius: 16rpx; color: var(--color-warning); background: var(--color-warning-surface); font-size: 24rpx; line-height: 1.5; }
.diff-row__date { font-weight: 700; font-variant-numeric: tabular-nums; }
.decision-options { display: flex; flex-direction: column; gap: 16rpx; margin: 24rpx 0; }
.decision-option { display: flex; box-sizing: border-box; min-height: 88rpx; align-items: center; gap: 16rpx; padding: 20rpx; border: 2rpx solid var(--color-border); border-radius: 16rpx; color: var(--color-text); font-size: 26rpx; }

.disclaimer { display: block; padding: 8rpx 8rpx 24rpx; }

@media (max-width: 360px) {
  .page { padding-right: 24rpx; padding-left: 24rpx; }
  .card { padding: 24rpx; }
  .row-actions { grid-template-columns: 1fr; }
  .meal-day__header, .meal-row { align-items: stretch; flex-direction: column; }
  .switch-control { justify-content: space-between; }
  .picker--compact { width: 100%; }
}
